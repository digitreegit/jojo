{
  "name": "jojo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@jojo/web",
    "dev:mobile": "pnpm --filter @jojo/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "supabase": "^2.120.0",
    "turbo": "^2.11.7",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=20.19"
  }
}
